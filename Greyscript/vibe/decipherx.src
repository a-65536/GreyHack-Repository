// decipherx - decrypt Grey Hack password hashes
//
// Passwords are cached in $HOME/AppData/decipherx/passwds.db.
// Each cache line is: HASH<TAB>PASSWORD.
// A 32-character hexadecimal target is treated as an MD5 hash.
//
// Environment failures are reported as "decipherx: ...".
// Logic, permission and data failures are reported as "Error: ...".

printUsage = function()
	exit("<b>decipherx (-W/-R) [encrypted file]</b>")
end function

joinPath = function(folder, name)
	if folder == null or folder == "" then return name
	if folder == "/" then return "/" + name
	if folder[folder.len - 1] == "/" then return folder + name
	return folder + "/" + name
end function

getComputer = function()
	shell = get_shell
	if shell == null then exit("decipherx: Unable to obtain a shell.")
	computer = shell.host_computer
	if computer == null then exit("decipherx: Unable to access the host computer.")
	return computer
end function

failFileOperation = function(action, detail)
	text = ""
	if detail != null then text = ("" + detail)
	if text.lower.indexOf("permission") != null or text.lower.indexOf("denied") != null then
		exit("Error: Permission denied while " + action + ".")
	end if
	exit("decipherx: Unable to " + action + ": " + text)
end function

ensureFolder = function(computer, path, parentPath, name)
	folder = computer.File(path)
	if folder != null then
		if folder.is_folder != 1 then
			exit("Error: " + path + " exists but is not a folder.")
		end if
		return folder
	end if
	createResult = computer.create_folder(parentPath, name)
	if typeof(createResult) == "string" then
		failFileOperation("creating " + path, createResult)
	end if
	if createResult != 1 then
		failFileOperation("creating " + path, "unknown error")
	end if
	folder = computer.File(path)
	if folder == null then
		exit("decipherx: Unable to access " + path + " after creating it.")
	end if
	return folder
end function

ensureCache = function(computer)
	userHome = "/home/" + active_user
	if userHome == null or userHome == "/home/" or computer.File(userHome) == null then
		userHome = home_dir
	end if
	if userHome == null or userHome == "" then
		exit("decipherx: Unable to determine the home directory.")
	end if
	homeFolder = computer.File(userHome)
	if homeFolder == null then
		exit("decipherx: Home directory not found: " + userHome)
	end if
	if homeFolder.has_permission("w") != 1 then
		exit("Error: Permission denied")
	end if

	appDataPath = joinPath(userHome, "AppData")
	cacheFolderPath = joinPath(appDataPath, "decipherx")
	appDataFolder = ensureFolder(computer, appDataPath, userHome, "AppData")
	if appDataFolder.has_permission("w") != 1 then
		exit("Error: Permission denied: cannot write to " + appDataPath)
	end if
	cacheFolder = ensureFolder(computer, cacheFolderPath, appDataPath, "decipherx")
	if cacheFolder.has_permission("w") != 1 then
		exit("Error: Permission denied: cannot write to " + cacheFolderPath)
	end if

	cachePath = joinPath(cacheFolderPath, "passwds.db")
	cacheFile = computer.File(cachePath)
	if cacheFile == null then
		touchResult = computer.touch(cacheFolderPath, "passwds.db")
		if typeof(touchResult) == "string" then
			failFileOperation("creating " + cachePath, touchResult)
		end if
		if touchResult != 1 then
			failFileOperation("creating " + cachePath, "unknown error")
		end if
		cacheFile = computer.File(cachePath)
	end if
	if cacheFile == null then
		exit("decipherx: Unable to access " + cachePath)
	end if
	if cacheFile.is_folder == 1 then
		exit("Error: " + cachePath + " is a folder, not a file.")
	end if
	if cacheFile.has_permission("r") != 1 or cacheFile.has_permission("w") != 1 then
		exit("Error: Permission denied")
	end if

	content = cacheFile.get_content
	if content == null then
		exit("Error: Unable to read " + cachePath)
	end if
	cache = {}
	if content.trim != "" then
		lineNumber = 0
		for line in content.split(char(10))
			lineNumber = lineNumber + 1
			row = line
			if row.trim == "" then continue
			if row[row.len - 1] == char(13) then row = row[:-1]
			columns = row.split(char(9))
			if columns.len != 2 then
				colonIndex = row.indexOf(":")
				if colonIndex != null then
					columns = [row[:colonIndex], row[colonIndex + 1:]]
				end if
			end if
			if columns.len != 2 then
				exit("Error: Corrupt cache at line " + lineNumber + " in " + cachePath)
			end if
			hash = columns[0].trim.upper
			password = columns[1]
			if hash == "" then
				exit("Error: Corrupt cache at line " + lineNumber + " in " + cachePath)
			end if
			cache[hash] = password
		end for
	end if

	return {"file": cacheFile, "cache": cache, "path": cachePath, "cryptools": null}
end function

saveCache = function(state)
	lines = []
	for hash in state.cache.indexes
		password = state.cache[hash]
		if password != null then
			lines.push(hash + char(9) + password)
		end if
	end for
	saveResult = state.file.set_content(lines.join(char(10)))
	if typeof(saveResult) == "string" then
		failFileOperation("saving " + state.path, saveResult)
	end if
	if saveResult != 1 then
		exit("Error: Unable to save " + state.path)
	end if
end function

isMd5 = function(value)
	if value == null then return false
	text = "" + value
	if text.len != 32 then return false
	return text.is_match("^[0-9A-Fa-f]{32}$")
end function

GetPassword = function(userPass, state)
	if userPass.len != 2 then return null
	hash = userPass[1]
	if hash == null or hash.len < 30 then return null
	cacheKey = hash.upper
	if state.cache.hasIndex(cacheKey) == 1 then return state.cache[cacheKey]

	if state.cryptools == null then
		state.cryptools = include_lib("/lib/crypto.so")
		if state.cryptools == null then exit("decipherx: Missing crypto library")
	end if
	password = state.cryptools.decipher(hash)
	if password != null then
		state.cache[cacheKey] = password
		saveCache(state)
	end if
	return password
end function

writeDecrypted = function(file, hash, password, writeFile)
	if not writeFile then return
	content = file.get_content
	content = content.replace(hash, password)
	file.set_content(content)
end function

main = function()
	if cliArgs.len < 1 then printUsage()

	writeFile = false
	recursive = false
	target = ""
	for arg in cliArgs
		lowerArg = arg.lower
		if lowerArg == "-h" or lowerArg == "--help" then printUsage()
		if arg.indexOf("-") == 0 then
			upperArg = arg.upper
			if upperArg.indexOf("-W") != null then writeFile = true
			if upperArg.indexOf("-R") != null then recursive = true
		else
			if target != "" then printUsage()
			target = arg
		end if
	end for
	if target == "" then printUsage()

	if isMd5(target) then
		computer = getComputer()
		state = ensureCache(computer)
		password = GetPassword(["user", target.lower], state)
		if password == null then exit("Error: Can't find password :(")
		exit(password)
	end if

	computer = getComputer()

	if recursive then
		file = computer.File(target)
		if file == null then exit("Error: can't find " + target)
		if file.has_permission("r") != 1 then exit("Error: can't read folder. Permission denied")
		if writeFile and file.has_permission("w") != 1 then
			print("Error: can't write file. Change to read only")
			writeFile = false
		end if
		if file.is_folder != 1 then exit("Error: " + target + " is not a folder")

		state = ensureCache(computer)
		queue = file.get_files + file.get_folders
		while len(queue) != 0
			current = queue.pull
			if current == null then continue
			if current.is_folder == 1 then
				queue = queue + current.get_files
				queue = queue + current.get_folders
				continue
			end if
			if current.is_binary then continue
			if current.has_permission("r") != 1 then continue
			if writeFile and current.has_permission("w") != 1 then continue
			content = current.get_content
			if content == null or content.len == 0 then continue

			lines = content.split("\n")
			if lines.len == 1 then
				userPass = lines[0].split(":")
				password = GetPassword(userPass, state)
				if password then print(userPass[0] + " => " + password)
				if password then writeDecrypted(current, userPass[1], password, writeFile)
			else
				for i in range(0, len(lines) - 1)
					userPass = lines[i].split(":")
					password = GetPassword(userPass, state)
					if password then print(userPass[0] + " => " + password)
					if password then writeDecrypted(current, userPass[1], password, writeFile)
				end for
			end if
		end while
		exit("Program ended")
	end if

	file = computer.File(target)
	if file == null then exit("Error: can't find " + target)
	if file.is_binary then exit("Error: can't read " + target + ". Binary file")
	if file.has_permission("r") != 1 then exit("Error: can't read file. Permission denied")
	if writeFile and file.has_permission("w") != 1 then
		print("Error: can't write file. Change to read only")
		writeFile = false
	end if
	content = file.get_content
	if content == null or content.len == 0 then exit("Error: no users found")
	lines = content.split("\n")
	state = ensureCache(computer)

	password = null
	if lines.len == 1 then
		userPass = lines[0].split(":")
		password = GetPassword(userPass, state)
		if not password then exit("Error: Can't find password :(")
		print("password found! => " + password)
		writeDecrypted(file, userPass[1], password, writeFile)
	else
		print("Multiple users found.")
		numLine = 1
		for line in lines
			if line.len > 0 then
				print(numLine + ": " + line)
				numLine = numLine + 1
			end if
		end for
		option = ""
		inputOk = false
		while(not inputOk)
			option = user_input("Select user: ").to_int
			if option == "*" then
				for i in range(0, len(lines) - 1)
					userPass = lines[i].split(":")
					password = GetPassword(userPass, state)
					if password then print(userPass[0] + " => " + password)
					if password then writeDecrypted(file, userPass[1], password, writeFile)
				end for
				exit("Program ended")
			else if typeof(option) != "number" or (option < 1 or option > lines.len) then
				print("Error: Invalid input. Type a valid number")
			else
				inputOk = true
			end if
		end while

		userPass = lines[option - 1].split(":")
		print("Selected user: " + userPass[0] + "\nDeciphering...")
		password = GetPassword(userPass, state)
		if not password then exit("Error: Can't find password :(")
		print("password found! => " + password)
		writeDecrypted(file, userPass[1], password, writeFile)
	end if
end function

cliArgs = params
main()
